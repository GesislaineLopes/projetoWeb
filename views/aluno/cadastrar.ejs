<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastrar alunos</title>
</head>
<body>
    <div class="container">
        <%- include("../partials/cabecalho") %>
        <h2>Cadastrar aluno</h2>
        <form action="/alunos" method="POST">
            <div>
            <!--ver o treco do boot strap pra esse negocio do label-->
                <label for="matricula" class="form-label">Matrícula:</label>
                <input type="text" class="form-control" required id="matricula" name="matricula">
            </div>
            <div>
                <label for="nome" class="form-label" >Nome:</label>
                <input type="text" class="form-control" required id="nome" name="nome">
            </div>
            <div>
                <label for="curso" class="form-label" >Curso:</label>
                <input type="text" class="form-control" required id="curso" name="curso">
            </div>
            <button type="submit" class="btn btn-success">Salvar</button>
        </form>
        <%- include("../partials/rodape") %>
    </div>
</body>
</html>