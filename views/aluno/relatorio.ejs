<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alunos 2</title>
    <%- include("../partials/cabecalho") %>
</head>
<body>
    <% if (status == '1') {%>
        <!--muda a cor do  alerta ao cadastrar um aluno, usando boot strap-->
        <div class="alert alert-success">
            Cadastrado com <b>sucesso.</b>
        </div>
    <% } %>
    <h2>Relatório de alunos</h2>
    <!-- esse primeiro "alunos" é o  nome do vetor -->
    <% alunos.forEach(aluno => {%>
        <div><b>Matricula:</b> <%= aluno.matricula %></div>
        <div><b>Nome:</b> <%= aluno.nome %></div>
        <div><b>Curso:</b> <%= aluno.curso %></div>
        <div><a href="/alunos/<%= aluno.matricula %>">Detalhar</a></div>
        <hr>
    <% }); %> 
    <%- include("../partials/rodape") %> 
</body>
</html>