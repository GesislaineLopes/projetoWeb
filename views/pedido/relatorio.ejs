<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Relatório de Pedidos</title>
    <link rel="stylesheet" href="/css/style.css" />
    <%- include("../partials/menu") %>
</head>
<body>
    <%- include("../partials/cabecalho") %>
    <div class="container" style="text-align: center;">
        <h2>Relatório de Pedidos</h2>
        <table class="table table-striped table-dark" style="margin-left: auto; margin-right: auto;">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Produtos</th>
                    <th>Quantidade</th>
                    <th>Preço Total</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% pedidos.forEach(function(pedido) { %>
                    <tr>
                        <td><%= pedido.cliente.nome %></td>
                        <td>
                            <ul>
                                <% pedido.produtos.forEach(function(item) { %>
                                    <li><%= item.produto.nome %></li>
                                <% }); %>
                            </ul>
                        </td>
                        <td>
                            <ul>
                                <% pedido.produtos.forEach(function(item) { %>
                                    <li><%= item.quantidade %></li>
                                <% }); %>
                            </ul>
                        </td>
                        <td>
                            R$ 
                            <%= pedido.produtos.reduce((total, item) => {
                                return total + (item.produto.preco * item.quantidade);
                            }, 0).toFixed(2) %>
                        </td>
                        <td>
                            <form method="POST" action="/pedidos/excluir/<%= pedido._id %>" onsubmit="return confirm('Tem certeza que deseja excluir este pedido?');" style="display:inline;">
                                <button type="submit" class="btn btn-danger">Excluir</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
    <%- include("../partials/rodape") %>
</body>
</html>
