<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark" >
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Editar Produto</title>
    <link rel="stylesheet" href="/css/style.css" />
    <%- include("../partials/menu") %>
</head>
<body>
    <%- include("../partials/cabecalho") %>
    <div class="container">
        <h2>Editar Produto</h2>
        <form method="POST" action="/produtos/editar/<%= produto._id %>">
            <div>
                <label for="nome" class="form-label">Nome:</label>
                <input type="text" class="form-control" id="nome" name="nome" value="<%= produto.nome %>" required />
            </div>
            <div>
                <label for="descricao" class="form-label">Descrição:</label>
                <textarea class="form-control" id="descricao" name="descricao"><%= produto.descricao %></textarea>
            </div>
            <div>
                <label for="preco" class="form-label">Preço:</label>
                <input type="number" step="0.01" class="form-control" id="preco" name="preco" value="<%= produto.preco %>" required min="0" />
            </div>
            <button type="submit" class="btn btn-primary mt-2">Salvar Alterações</button>
            <a href="/produtos" class="btn btn-secondary mt-2 ms-2">Cancelar</a>
        </form>
    </div>
    <%- include("../partials/rodape") %>
</body>
</html>
